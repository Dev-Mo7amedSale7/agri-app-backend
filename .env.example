# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
# For development, use SQLite for easier setup
DATABASE_URL=sqlite:///farm_delivery.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/farm_delivery

# Delivery Fee
DELIVERY_FEE=30

# CORS Configuration
CORS_ORIGINS=*
